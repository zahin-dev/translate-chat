FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml ./
COPY src/main ./src/main
RUN mvn -B -DskipTests package

FROM eclipse-temurin:21-jre-jammy
RUN useradd --system --uid 10001 --user-group app
WORKDIR /app
COPY --from=build --chown=10001:10001 /build/target/translate-chat-*.jar /app/app.jar
USER 10001:10001
ENV SPRING_PROFILES_ACTIVE=cloud
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=60.0", "-XX:+ExitOnOutOfMemoryError", "-jar", "/app/app.jar"]
